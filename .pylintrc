[MASTER]
# Files or directories to be ignored
ignore=node_modules,.venv,dashboard,dist,build,scratch,archive,resume-engine/archive
ignore-patterns=.*archive.*,.*scratch.*
init-hook='import sys, os; sys.path.insert(0, os.path.abspath("scripts"))'
ignored-modules=google,google.genai,genai
extension-pkg-allow-list=google.genai,pydantic

[MESSAGES CONTROL]
# Disable the message, report, category or checker with the given id(s).
disable=
    C0111, # missing-docstring
    C0114, # missing-module-docstring
    C0115, # missing-class-docstring
    C0116, # missing-function-docstring
    C0103, # invalid-name
    C0200, # consider-using-enumerate
    C0209, # consider-using-f-string
    C0301, # line-too-long
    C0302, # too-many-lines
    C0303, # trailing-whitespace
    C0304, # missing-final-newline
    C0305, # trailing-newlines
    C0325, # superfluous-parens
    C0411, # wrong-import-order
    C0413, # wrong-import-position
    C0415, # import-outside-toplevel
    E1120, # no-value-for-parameter
    E1136, # unsubscriptable-object
    R0801, # duplicate-code
    R0902, # too-many-instance-attributes
    R0903, # too-few-public-methods
    R0904, # too-many-public-methods
    R0911, # too-many-return-statements
    R0912, # too-many-branches
    R0913, # too-many-arguments
    R0914, # too-many-locals
    R0915, # too-many-statements
    R0917, # too-many-positional-arguments
    R1702, # too-many-nested-blocks
    R1705, # no-else-return
    R1710, # inconsistent-return-statements
    R1723, # no-else-break
    R1731, # consider-using-max-builtin
    R1732, # consider-using-with
    W0101, # unreachable
    W0107, # unnecessary-pass
    W0125, # using-constant-test
    W0130, # duplicate-value
    W0212, # protected-access
    W0311, # bad-indentation
    W0404, # reimported
    W0511, # fixme (todo)
    W0603, # global-statement
    W0611, # unused-import
    W0612, # unused-variable
    W0613, # unused-argument
    W0621, # redefined-outer-name
    W0640, # cell-var-from-loop
    W0703, # broad-except
    W0718, # broad-exception-caught
    W0719, # broad-exception-raised
    W1203, # logging-fstring-interpolation
    W1309, # f-string-without-interpolation
    W1510, # subprocess-run-check
    W1514  # unspecified-encoding

[FORMAT]
max-line-length=120
