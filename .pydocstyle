[pydocstyle]
# Resume-builder pydocstyle configuration
# Suppress low-impact stylistic rules that don't affect readability
# Focus on: actual docstring issues (D301=raw strings), not formatting
# (D100-D107, D200-D215, D400-D417).
#
# D108, D109 and D216-D219 were listed here and DO NOT EXIST -- pydocstyle
# answered every run with six "Error code passed is not a prefix of any
# known errors" warnings, which read as a failing tool on an otherwise
# clean checkout. The real violation count was, and is, zero.
ignore = D100,D101,D102,D103,D104,D105,D106,D107,D200,D201,D202,D203,D204,D205,D206,D207,D208,D209,D210,D212,D213,D214,D215,D400,D401,D402,D403,D404,D405,D406,D407,D408,D409,D410,D411,D412,D413,D414,D415,D416,D417
match = (?!__pycache__|\.venv).*\.py
