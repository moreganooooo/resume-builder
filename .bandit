# Bandit security configuration for resume-builder
# Suppress low-severity patterns that are either false positives or intentional

exclude_dirs:
  - /tests/
  - test_

skips:
  # B110: try-except-pass - Intentional graceful degradation throughout codebase
  # B603: subprocess without shell - Subprocess calls are safe (no shell injection)
  # B404: import subprocess - Standard library import, needed for functionality
  # B311: random module - Used for non-cryptographic purposes only
  # B112: try-except-pass (same as B110)
  # B607: start process with partial path - Internal tool usage only
  # B608: hardcoded SQL - Uses parameterized queries (false positive)
  # B105: hardcoded password - False positive on numeric constants
  # B606: os.startfile() - Windows-safe platform-specific call
  - B110
  - B603
  - B404
  - B311
  - B112
  - B607
  - B608
  - B105
  - B606
