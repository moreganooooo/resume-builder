# Copy this file to .env and fill in your key. Loaded via python-dotenv
# by orchestrator.py / rewrite_bullets.py at startup. Never commit the
# real .env -- it's already covered by .gitignore.

# Google AI Studio API key (https://aistudio.google.com/apikey).
# gemini_client.py accepts either variable name -- only one is required.
GEMINI_API_KEY=
GOOGLE_API_KEY=
