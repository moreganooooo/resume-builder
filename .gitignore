# === SECRETS & KEYS ===
.env
.env.*
*.env
secrets.yaml
secrets.json
api_keys.txt
config.local.*
*.meta
*/.meta
**/.meta


# === PERSONAL IDENTIFYING ASSETS ===
# A handwritten-style signature image is personal, identifying content --
# same conservative posture as the PII note below for scanned JD data.
# profiles/<name>/signature.{png,jpg,jpeg} -- see profile_paths.signature_path().
profiles/*/signature.png
profiles/*/signature.jpg
profiles/*/signature.jpeg


# === AUDIT & OUTPUT FILES (may contain keys or PII) ===
# IMPORTANT: Be specific here. Wildcards like *audit*.csv will catch
# bullet-bank-keepers-audited.csv if it ever needs to be re-added.
audit-discrepancies.csv
audit-rewrite-queue.csv
*_log.csv
*_log.json
data/applications.md
data/**/applications.md
output/
logs/
*.log


# === SCANNED JD POSTINGS & PROFILE-SCOPED JD DIRECTORIES ===
# real company data + PII -- JobRight/LinkedIn results can include
# social_connections with real people's names and LinkedIn URLs.
# Only code is tracked, never the postings themselves.
# Exceptions: dummy_jd.txt and jds/expired/ (fixtures/historical data).
# Profile-scoped directories (jds/<profile>/) sync via Syncthing instead.
jds/**/*.json
# Glob, not a per-name list. create_new_profile() never touches .gitignore,
# so hardcoded names meant a third profile's entire saved-JD corpus was
# untracked-and-not-ignored in a repo whose workflow is `git pull` -- and
# git_update's has_uncommitted_changes() counts untracked files, so the
# update flow actively nudged that user toward committing their own PII.
jds/*/


# === RESUME OUTPUT & PROFILE-SCOPED DATA ===
# Generated PDFs, intermediate files, and profile data all sync via Syncthing.
tailored_resume*.json
*_tailored.json
*_resume.json
*.gems_report.json
MorganEscott_*.pdf
*_Resume.pdf
*_resume.pdf
*.npy
*.npz
# Globs, not per-name lines -- see the note in the JD section above. Every
# profile's knowledge base and data/ is personal by default; the board_scanner
# YAML below is the one deliberately-tracked exception (committed scaffold,
# no PII), so it needs both the directory re-included and the file re-included.
profiles/*/
!profiles/*/board_scanner/
!profiles/*/board_scanner/*.yml
data/*/


# === PYTHON ===
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/


# === NODE ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === GO (dashboard/) ===
# scripts/dashboard.py always invokes `go run .`, never `go build`, so
# nothing here is expected to appear -- this just guards against a stray
# manual `go build` leaving a compiled binary or local module cache.
/dashboard/dashboard
/dashboard/rb-dashboard


# === MULTI-COMPUTER SYNC (Syncthing) ===
# Auto-regenerated identically by profile_paths.write_sync_ignore_files()
# on every profile -- see CLAUDE.md's "Multi-computer sync" section.
# Not worth tracking: it's boilerplate, not personalization data, and
# output/'s copy is already excluded by the blanket output/ rule below --
# this just keeps profiles/jds/data consistent with that.
.stignore
**/.stfolder/


# === OS ===
.DS_Store
**/.DS_Store


# === CLAUDE SUPERPOWERS SCRATCH ===
.superpowers/
.worktrees/

# === CLAUDE LOCAL NOTES (personal, machine-specific) ===
.claude.local.md

# === PERSONAL CONVERSATION EXPORTS (not project code) ===
resume-builder-conversations-perplexity/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Fedora-only WebKit-via-podman workaround (see .claude.local.md) -- not
# needed/not relevant on machines where WebKit runs natively.
/scripts/local-webkit-test.sh
/scripts/local-webkit-test.Containerfile
