/scripts/local-webkit-test.sh
/scripts/local-webkit-test.Containerfile
.aider*

# Throwaway analysis/triage files. `scratch/*` (contents), not `scratch/`
# (the directory) -- same reason as the profiles/*/* rule above. Anything
# already tracked here (scratch/rewrite.py) is unaffected: gitignore does
# not apply to tracked files.
scratch/*
2026-09-19-154051-local-command-caveatcaveat-the-messages-below.txt
.gitignore
backups/relabel-20260916/bullet-bank-keepers.csv
backups/relabel-20260916/bullet-bank-keepers-audited.csv

# Tool output and research scratch, not source. These were tracked by
# accident and were the bulk of the repo (~49 MB) until their history was
# rewritten out on 2026-09-22: nogic's local index, graphify's generated
# graph/AST/cache, and the scraped screenshots behind docs/morgan_research.
# Nothing references them outside graphify's own generated index.
/.nogic/
/graphify-out/
/docs/morgan_research/CrushPhotos/
