# In critique_resume() in orchestrator.py\
def critique_resume(resume_json_path: str, jd_path: str, profile_name: str) -> dict:\
    # ... existing code ...\
\
    # Add gap analysis\
    jd_data = _parse_jd_data(jd_text)\
    jd_required_skills = jd_data.get("qualifications", \{\}).get("mustHave", [])\
    jd_nice_to_have = jd_data.get("qualifications", \{\}).get("niceToHave", [])\
\
    # Extract skills from resume\
    resume_skills = set()\
    for role in resume_json.get("EXPERIENCE", []):\
        for bullet in role.get("achievements", []):\
            # Simple keyword extraction (could be enhanced with NLP)\
            words = re.findall(r"\\b[\\w-]+\\b", bullet.lower())\
            resume_skills.update(words)\
    for category in resume_json.get("SKILLS", []):\
        resume_skills.update([s.lower() for s in category.get("items", [])])\
\
    # Identify gaps\
    missing_required = []\
    missing_nice_to_have = []\
    for skill in jd_required_skills:\
        if skill.lower() not in resume_skills:\
            missing_required.append(skill)\
    for skill in jd_nice_to_have:\
        if skill.lower() not in resume_skills:\
            missing_nice_to_have.append(skill)\
\
    # Add to critique output\
    critique_output["GAP_ANALYSIS"] = \{\
        "missing_required": missing_required,\
        "missing_nice_to_have": missing_nice_to_have,\
        "suggested_bullets": suggest_bullets_for_gaps(missing_required, missing_nice_to_have, profile_name),\
    \}\
\
    return critique_output\
\
def suggest_bullets_for_gaps(missing_required: list, missing_nice_to_have: list, profile_name: str) -> list:\
    """Suggest bullets from the bank that cover missing skills."""\
    profile = profile_name or profile_paths.active_profile()\
    kb_dir = profile_paths.kb_dir(profile)\
    bullet_bank_path = os.path.join(kb_dir, "bullet-bank-keepers-audited.csv")\
    bullet_bank = pd.read_csv(bullet_bank_path)\
\
    suggested = []\
    for skill in missing_required + missing_nice_to_have:\
        # Find bullets containing the skill\
        matches = bullet_bank[bullet_bank["bullet_text"].str.contains(skill, case=False, na=False)]\
        if not matches.empty:\
            # Pick the highest-scoring bullet\
            best_bullet = matches.loc[matches["score"].idxmax()]\
            suggested.append(\{\
                "skill": skill,\
                "bullet": best_bullet["bullet_text"],\
                "source": best_bullet["source"],\
                "priority": "required" if skill in missing_required else "nice-to-have",\
            \})\
\
    return suggested\
