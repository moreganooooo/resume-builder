def generate_gap_analysis(jd_data: dict, resume_json: dict, profile_data: dict) -> list:\
    """Generates a gap analysis table for JD requirements vs resume/profile."""\
    jd_requirements = extract_requirements(jd_data)\
    gap_table = []\
\
    for req in jd_requirements:\
        # Check if requirement is in resume\
        in_resume = check_in_resume(req, resume_json)\
\
        # Check if requirement is in profile\
        in_profile = check_in_profile(req, profile_data)\
\
        # Get verification source (if applicable)\
        verified_by = get_verification_source(req, profile_data) if in_profile else None\
\
        # Determine action\
        if not in_profile:\
            action = "Likely not needed or find similar"\
        elif not in_resume:\
            action = f"Add a tailored bullet about \{req\}"\
        else:\
            action = "Already covered"\
