def score_base_resumes(jd_path: str, profile_name: str = None) -> dict:\
    """Scores all base resumes against the JD and returns the best one."""\
    profile = profile_name or profile_paths.active_profile()\
    variants_dir = os.path.join(profile_paths.output_dir(profile), "variants")\
    jd_text = open(jd_path).read()\
    jd_data = _parse_jd_data(jd_text)\
\
    if not os.path.exists(variants_dir):\
        raise FileNotFoundError(f"No variants found in \{variants_dir\}. Run generate-variants first.")\
\
    best_variant = None\
    best_score = -1\
\
    for variant_file in os.listdir(variants_dir):\
        if not variant_file.endswith(".json"):\
            continue\
\
        variant_path = os.path.join(variants_dir, variant_file)\
        variant_data = json.load(open(variant_path))\
        archetype_name = variant_file.replace(".json", "")\
\
        # Score this variant against the JD\
        score = score_base_resume(variant_data, jd_data)\
\
        if score > best_score:\
            best_score = score\
            best_variant = \{\
                "archetype": archetype_name,\
                "resume_json": variant_data,\
                "score": score,\
            \}\
\
    if best_variant is None:\
        raise RuntimeError("No valid variants found.")\
\
    # Generate gap analysis for the best variant\
    gap_table = generate_gap_analysis(jd_data, best_variant["resume_json"], profile_paths.profile_yaml(profile))\
\
    return \{\
        **best_variant,\
        "gap_table": gap_table,\
    \}\
\
def score_base_resume(variant_data: dict, jd_data: dict) -> float:\
    """Scores a single variant against the JD."""\
    # 1. Skill Coverage Score (40%)\
    jd_keywords = extract_keywords(jd_data.get("description", ""))\
    variant_keywords = extract_keywords(\
        variant_data.get("SUMMARY_TEXT", "") + " " +\
        " ".join(variant_data.get("SKILLS", [\{\}])[0].get("items", [])) + " " +\
        " ".join(bullet for role in variant_data.get("EXPERIENCE", [])\
                for bullet in role.get("achievements", []))\
    )\
    skill_score = len(set(jd_keywords) & set(variant_keywords)) / len(jd_keywords) if jd_keywords else 1.0\
\
    # 2. Title/Level Match (20%)\
    jd_title = jd_data.get("title", "").lower()\
    variant_title = variant_data.get("TAGLINE", "").lower()\
    title_score = fuzzy_match(jd_title, variant_title)\
\
    # 3. Experience Relevance (20%)\
    jd_years = extract_years_required(jd_data.get("description", ""))\
    variant_years = variant_data.get("metadata", \{\}).get("years_experience", 0)\
    exp_score = min(jd_years / max(variant_years, 1), 1.0)\
\
    # 4. Recency/Domain Fit (10%)\
    jd_industry = jd_data.get("industry", "")\
    variant_industry = variant_data.get("metadata", \{\}).get("industries", [""])[0]\
    recency_score = domain_similarity(jd_industry, variant_industry)\
\
    # 5. Free-Text Similarity (10%)\
    jd_embedding = embed_text(jd_data.get("description", ""))\
    variant_embedding = embed_text(\
        variant_data.get("SUMMARY_TEXT", "") + " " +\
        " ".join(variant_data.get("SKILLS", [\{\}])[0].get("items", []))\
    )\
    sim_score = cosine_similarity([jd_embedding], [variant_embedding])[0][0]\
\
    return 0.4*skill_score + 0.2*title_score + 0.2*exp_score + 0.1*recency_score + 0.1*sim_score\
