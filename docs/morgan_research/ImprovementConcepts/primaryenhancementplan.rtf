# In scripts/company_research.py (enhanced)\
def research_company(company_name: str, jd_data: dict = None) -> dict:\
    """\
    Research a company's tone, values, and culture from their website.\
    Returns:\
        - tone_adjective (e.g., "collaborative", "innovative")\
        - tone_register (e.g., "formal", "casual")\
        - recurring_keywords (e.g., ["customer", "innovation", "team"])\
        - company_facts (e.g., ["Founded in 2015", "500+ employees"])\
    """\
    import requests\
    from bs4 import BeautifulSoup\
    from gemini_client import GeminiClient\
\
    # Step 1: Find company website\
    website = find_company_website(company_name)\
    if not website:\
        return \{"error": f"Could not find website for \{company_name\}"\}\
\
    # Step 2: Scrape homepage and about page\
    try:\
        homepage = requests.get(website, timeout=10).text\
        about_page = requests.get(f"\{website\}/about", timeout=10).text\
        careers_page = requests.get(f"\{website\}/careers", timeout=10).text\
    except Exception as e:\
        return \{"error": f"Failed to scrape \{website\}: \{e\}"\}\
\
    # Step 3: Extract tone and keywords\
    text = f"\{homepage\}\\n\{about_page\}\\n\{careers_page\}"\
    soup = BeautifulSoup(text, "html.parser")\
    clean_text = soup.get_text(separator="\\n", strip=True)\
\
    # Use LLM to analyze tone\
    prompt = f"""Analyze the following company website text and extract:\
1. tone_adjective: One word describing the overall tone (e.g., "collaborative", "innovative", "formal").\
2. tone_register: "formal", "casual", or "mixed".\
3. recurring_keywords: 3-5 keywords that appear frequently.\
4. company_facts: 2-3 factual statements about the company.\
\
Text:\
\{clean_text[:10000]\}  # Limit to 10K chars to save tokens\
"""\
\
    text, _ = GeminiClient.generate(\
        model="gemini-3.1-flash-lite",\
        system_instruction="You are a company researcher. Extract tone and facts precisely.",\
        contents=prompt,\
        temperature=0.0,\
    )\
\
    try:\
        return GeminiClient.parse_json(text)\
    except Exception:\
        return \{"error": "Failed to parse company research"\}\
\
def match_resume_to_company_tone(resume_json: dict, company_research: dict) -> dict:\
    """\
    Suggests edits to match the resume's tone to the company's tone.\
    Returns:\
        - tone_match_score: 0-100\
        - suggestions: list of edits\
    """\
    resume_tone = detect_tone(json.dumps(resume_json), cultural_fit_rules["tone_keywords"])\
    company_tone = company_research\
\
    # Score match\
    tone_match_score = score_tone_match(resume_tone, company_tone, 0.3)\
\
    # Generate suggestions\
    suggestions = []\
    if company_tone.get("tone_adjective") == "collaborative" and resume_tone.get("collaborative", 0) < 2:\
        suggestions.append("Use more collaborative language (e.g., 'we', 'team', 'together') in your summary.")\
    if company_tone.get("tone_register") == "formal" and resume_tone.get("formal", 0) < 2:\
        suggestions.append("Use more formal language (e.g., 'please', 'thank you') in your resume.")\
\
    return \{\
        "tone_match_score": tone_match_score,\
        "suggestions": suggestions,\
    \}\
