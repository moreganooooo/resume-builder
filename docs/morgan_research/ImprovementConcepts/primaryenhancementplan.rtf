def validate_bullet_quality(bullet: str, style_rules: dict) -> list:\
    """Checks a bullet for semantic issues (beyond formatting)."""\
    issues = []\
\
    # --- Check 1: No Metric ---\
    if not re.search(r"\\d+[\\.,]?\\d*[\\% \\$]?", bullet):\
        issues.append(\{\
            "issue": "no_metric",\
            "message": "Consider adding a quantifiable result to show impact (e.g., 'increased X by 20%').",\
            "severity": "warning",\
            "bullet": bullet,\
        \})\
\
    # --- Check 2: Passive Voice ---\
    passive_patterns = [\
        r"\\bam\\b|\\bare\\b|\\bis\\b|\\bwas\\b|\\bwere\\b|\\bbe\\b|\\bbeing\\b|\\bby\\b",\
        r"\\bpassive\\b|\\bhandled\\b|\\bmanaged\\b",  # Weak verbs\
    ]\
    for pattern in passive_patterns:\
        if re.search(pattern, bullet, re.IGNORECASE):\
            issues.append(\{\
                "issue": "passive_voice",\
                "message": "Rewrite in active voice (e.g., 'Built X' instead of 'X was built').",\
                "severity": "warning",\
                "bullet": bullet,\
            \})\
            break\
\
    # --- Check 3: Generic Phrasing ---\
    generic_phrases = [\
        "responsible for",\
        "duties included",\
        "worked on",\
        "involved in",\
        "assisted with",\
        "helped with",\
    ]\
    for phrase in generic_phrases:\
        if phrase in bullet.lower():\
            issues.append(\{\
                "issue": "generic_phrasing",\
                "message": f"Replace '\{phrase\}' with a stronger, more specific verb (e.g., 'Led X').",\
                "severity": "error",\
                "bullet": bullet,\
            \})\
            break\
\
    # --- Check 4: Too Many Actions (and) ---\
    if bullet.lower().count(" and ") > 1:\
        issues.append(\{\
            "issue": "too_many_actions",\
            "message": "Split this bullet into multiple bullets (one per action).",\
            "severity": "warning",\
            "bullet": bullet,\
        \})\
\
    # --- Check 5: Weak Verbs ---\
    weak_verbs = [\
        "helped", "assisted", "supported", "worked on", "was involved in",\
        "participated in", "contributed to", "handled", "managed",\
    ]\
    for verb in weak_verbs:\
        if verb in bullet.lower():\
            issues.append(\{\
                "issue": "weak_verb",\
                "message": f"Replace '\{verb\}' with a stronger verb (e.g., 'Built', 'Led', 'Designed').",\
                "severity": "warning",\
                "bullet": bullet,\
            \})\
            break\
\
    # --- Check 6: No Clear Outcome ---\
    outcome_keywords = ["increased", "decreased", "improved", "reduced", "grew", "boosted", "achieved", "delivered"]\
    if not any(keyword in bullet.lower() for keyword in outcome_keywords):\
        issues.append(\{\
            "issue": "no_clear_outcome",\
            "message": "Add a clear outcome or result (e.g., '...increasing revenue by 20%').",\
            "severity": "warning",\
            "bullet": bullet,\
        \})\
\
    return issues\
