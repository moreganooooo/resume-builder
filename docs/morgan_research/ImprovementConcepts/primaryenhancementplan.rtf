from sentence_transformers import SentenceTransformer\
import numpy as np\
from sklearn.metrics.pairwise import cosine_similarity\
\
# Load model (cache it for performance)\
MODEL = None\
\
def get_model():\
    """Lazy-loads the sentence transformer model."""\
    global MODEL\
    if MODEL is None:\
        MODEL = SentenceTransformer('all-MiniLM-L6-v2')\
    return MODEL\
\
def rank_jobs_by_semantic_match(profile_data: dict, jds: list) -> list:\
    """Ranks JDs by semantic similarity to the profile."""\
    model = get_model()\
\
    # Embed profile\
    profile_text = build_profile_text(profile_data)\
    profile_embedding = model.encode(profile_text)\
\
    # Embed and rank JDs\
    ranked_jds = []\
    for jd in jds:\
        jd_text = build_jd_text(jd)\
        jd_embedding = model.encode(jd_text)\
        similarity = cosine_similarity([profile_embedding], [jd_embedding])[0][0]\
        ranked_jds.append(\{\
            **jd,\
            "semantic_score": similarity,\
        \})\
\
    # Sort by semantic score (descending)\
    ranked_jds.sort(key=lambda x: x["semantic_score"], reverse=True)\
    return ranked_jds\
\
def build_profile_text(profile_data: dict) -> str:\
    """Builds a text representation of the profile for embedding."""\
    parts = []\
\
    # Summary\
    if "summary" in profile_data:\
        parts.append(profile_data["summary"])\
\
    # Skills\
    if "skills" in profile_data:\
        parts.append(" ".join(profile_data["skills"]))\
\
    # Experience\
    if "experience" in profile_data:\
        for role in profile_data["experience"]:\
            parts.append(f"\{role.get('title', '')\} at \{role.get('company', '')\} (\{role.get('period', '')\})")\
            if "achievements" in role:\
                parts.append(" ".join(role["achievements"]))\
\
    return " ".join(parts)\
\
def build_jd_text(jd: dict) -> str:\
    """Builds a text representation of the JD for embedding."""\
    parts = []\
\
    # Title\
    if "title" in jd:\
        parts.append(jd["title"])\
\
    # Company\
    if "company" in jd:\
        parts.append(jd["company"])\
\
    # Description\
    if "description" in jd:\
        parts.append(jd["description"])\
\
    # Skills\
    if "skills" in jd:\
        parts.append(" ".join(jd["skills"]))\
\
    return " ".join(parts)\
