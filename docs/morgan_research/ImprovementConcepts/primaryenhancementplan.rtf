def rank_jobs_by_semantic_match(profile_data: dict, jds: list) -> list:\
    """Ranks JDs by semantic similarity to the profile."""\
    from sentence_transformers import SentenceTransformer\
\
    model = SentenceTransformer('all-MiniLM-L6-v2')\
\
    # Embed profile\
    profile_text = f"\{profile_data.get('summary', '')\} \{' '.join(profile_data.get('skills', []))\}"\
    profile_embedding = model.encode(profile_text)\
\
    # Embed and rank JDs\
    ranked_jds = []\
    for jd in jds:\
        jd_text = f"\{jd.get('title', '')\} \{jd.get('description', '')\}"\
        jd_embedding = model.encode(jd_text)\
        similarity = cosine_similarity([profile_embedding], [jd_embedding])[0][0]\
        ranked_jds.append(\{\
            **jd,\
            "semantic_score": similarity,\
        \})\
\
    # Sort by semantic score (descending)\
    ranked_jds.sort(key=lambda x: x["semantic_score"], reverse=True)\
    return ranked_jds\
