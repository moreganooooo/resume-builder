def suggest_bullets_for_gaps(missing_requirements: list, profile_name: str = None) -> list:\
    """Suggests bullets from the bank that cover missing requirements."""\
    profile = profile_name or profile_paths.active_profile()\
    kb_dir = profile_paths.kb_dir(profile)\
    bullet_bank_path = os.path.join(kb_dir, "bullet-bank-keepers-audited.csv")\
\
    if not os.path.exists(bullet_bank_path):\
        return []\
\
    bullet_bank = pd.read_csv(bullet_bank_path)\
    suggested_bullets = []\
\
    for req in missing_requirements:\
        # Find bullets containing the requirement\
        matches = bullet_bank[bullet_bank["bullet_text"].str.contains(req, case=False, na=False)]\
        if not matches.empty:\
            # Pick the highest-scoring bullet\
            best_bullet = matches.loc[matches["score"].idxmax()]\
            suggested_bullets.append(\{\
                "requirement": req,\
                "bullet_text": best_bullet["bullet_text"],\
                "source": best_bullet["source"],\
                "score": best_bullet["score"],\
                "strength_category": best_bullet["strength_category"],\
                "priority": "required" if req in jd_data.get("must_have_skills", []) else "nice-to-have",\
            \})\
\
    return suggested_bullets\
