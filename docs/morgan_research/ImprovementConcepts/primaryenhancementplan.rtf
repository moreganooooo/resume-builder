# In mine_bullet_bank() or select_bullets_for_resume()\
def score_bullet_by_depth(bullet: str, jd_keywords: dict, verified_tools: list) -> float:\
    """Scores a bullet based on tool depth (years, proficiency)."""\
    score = 0.0\
    for tool in jd_keywords.get("tools", []):\
        for verified_tool in verified_tools:\
            if tool.lower() == verified_tool["name"].lower():\
                # Add points for years of experience\
                score += verified_tool.get("years", 0) * 0.1\
                # Add points for proficiency\
                proficiency_scores = \{"Beginner": 0.1, "Intermediate": 0.2, "Advanced": 0.3, "Expert": 0.4\}\
                score += proficiency_scores.get(verified_tool.get("proficiency", "Beginner"), 0)\
    return score\
