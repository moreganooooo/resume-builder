def rank_and_store_jds(profile_name: str = None):\
    """Ranks all stored JDs by semantic match to the profile and updates their scores."""\
    profile = profile_name or profile_paths.active_profile()\
    jds_dir = profile_paths.jds_dir(profile)\
    profile_data = profile_paths.profile_yaml(profile)\
\
    # Load all JDs\
    jds = []\
    for jd_file in os.listdir(jds_dir):\
        if jd_file.endswith(".txt") or jd_file.endswith(".json"):\
            jd_path = os.path.join(jds_dir, jd_file)\
            jd_data = _parse_jd_data(open(jd_path).read())\
            jds.append(jd_data)\
\
    # Rank JDs\
    ranked_jds = rank_jobs_by_semantic_match(profile_data, jds)\
\
    # Update JD metadata\
    for jd in ranked_jds:\
        jd_path = os.path.join(jds_dir, os.path.basename(jd.get("file_path", "")))\
        jd_manager.update_jd(jd_path, profile, \{\
            "semantic_score": jd["semantic_score"],\
        \})\
\
    return ranked_jds\
