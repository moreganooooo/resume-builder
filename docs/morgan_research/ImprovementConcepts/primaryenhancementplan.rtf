def compute_coverage_matrix(jd_data: dict, resume_json: dict, profile_data: dict) -> list:\
    """Computes a coverage matrix for JD requirements vs resume/profile."""\
    jd_requirements = extract_requirements(jd_data)\
    coverage_matrix = []\
\
    for req in jd_requirements:\
        in_jd = True  # Always true for JD requirements\
        in_resume = check_in_resume(req, resume_json)\
        in_profile = check_in_profile(req, profile_data)\
        verified_by = get_verification_source(req, profile_data) if in_profile else None\
\
        coverage_matrix.append(\{\
            "requirement": req,\
            "in_jd": in_jd,\
            "in_resume": in_resume,\
            "in_profile": in_profile,\
            "verified_by": verified_by,\
            "priority": "required" if req in jd_data.get("must_have_skills", []) else "nice-to-have",\
        \})\
\
    return coverage_matrix\
