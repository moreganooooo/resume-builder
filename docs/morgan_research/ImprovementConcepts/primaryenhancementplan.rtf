def run(jd_path: str, profile_name: str = None):\
    profile = profile_name or profile_paths.active_profile()\
    jd_basename = os.path.basename(jd_path).replace(".txt", "").replace(".json", "")\
\
    print(f"\\n
\f3 \uc0\u55357 \u56960
\f9  Running pipeline for \{jd_basename\} (profile: \{profile\})")\
\
    # --- STEP 0: EVALUATE FIT ---\
    print("\\n
\f3 \uc0\u55357 \u56522
\f9  Step 0: Evaluating fit...")\
    fit_report = evaluate_fit(jd_path, profile)\
    if fit_report["recommendation"] == "Skip":\
        print(f"
\f3 \uc0\u10060
\f9  Skipping JD: \{fit_report['why']\}")\
        return\
    print(f"
\f3 \uc0\u9989
\f9  Fit score: \{fit_report['composite_score']:.1f\}/100 - \{fit_report['recommendation']\}")\
\
    # --- STEP 0.5: SCORE AND SELECT BASE RESUME ---\
    print("\\n
\f3 \uc0\u55356 \u57263
\f9  Step 0.5: Scoring base resumes...")\
    variants_dir = os.path.join(profile_paths.output_dir(profile), "variants")\
    if os.path.exists(variants_dir) and len(os.listdir(variants_dir)) > 1:\
        base_selection = score_base_resumes(jd_path, profile)\
        print(f"
\f3 \uc0\u9989
\f9  Selected base resume: \{base_selection['archetype']\} (score: \{base_selection['score']:.2f\})")\
\
        # Check for gaps\
        if base_selection["gap_table"]:\
            print("\\n
\f3 \uc0\u55357 \u56589
\f9  Gap Analysis:")\
            print_gap_analysis(base_selection["gap_table"])\
\
            # Auto-suggest bullets to fill gaps\
            suggested_bullets = suggest_bullets_for_gaps(\
                [row["requirement"] for row in base_selection["gap_table"] if not row["in_resume"]],\
                profile\
            )\
            if suggested_bullets:\
                print("\\n
\f3 \uc0\u55357 \u56481
\f9  Suggested Bullets to Fill Gaps:")\
                for i, bullet in enumerate(suggested_bullets, 1):\
                    print(f"   \{i\}. \{bullet['bullet_text']\} (Priority: \{bullet['priority']\})")\
\
        # Start from the selected base resume\
        resume_json = base_selection["resume_json"]\
        resume_json["jd_path"] = jd_path\
        resume_json["jd_basename"] = jd_basename\
        resume_json["selected_base"] = base_selection["archetype"]\
\
        # Save the selected base + gaps to JD manager\
        jd_manager.update_jd(jd_path, profile, \{\
            "selected_base": base_selection["archetype"],\
            "base_score": base_selection["score"],\
            "gap_table": base_selection["gap_table"],\
        \})\
\
        # Skip Steps 1-2 (Mining & Audit) since we're starting from a variant\
        refined_bullets_path = None\
        audited_bullets_path = None\
    else:\
        # Fallback to original pipeline\
        print("\\n
\f3 \uc0\u9888 \u65039
\f9   No base resumes found. Falling back to from-scratch generation...")\
        base_selection = None\
        refined_bullets_path = None\
        audited_bullets_path = None\
\
    # --- STEP 1: MINE BULLET BANK (if no base selected) ---\
    if refined_bullets_path is None:\
        print("\\n
\f3 \uc0\u55357 \u56589
\f9  Step 1: Mining bullet bank...")\
        refined_bullets_path = os.path.join(\
            profile_paths.output_dir(profile),\
            "refined_bullets",\
            f"\{jd_basename\}.csv"\
        )\
        if not os.path.exists(refined_bullets_path):\
            refined_bullets = mine_bullet_bank(jd_path, profile)\
            refined_bullets.to_csv(refined_bullets_path, index=False)\
        else:\
            refined_bullets = pd.read_csv(refined_bullets_path)\
        print(f"
\f3 \uc0\u9989
\f9  Mined \{len(refined_bullets)\} bullets")\
\
    # --- STEP 2: AUDIT LOOP (if no base selected) ---\
