def parse_pdf(pdf_path: str) -> dict:\
    """Parses a resume PDF and extracts structured data."""\
    import pdfminer.high_level\
    import re\
\
    # Extract raw text\
    text = pdfminer.high_level.extract_text(pdf_path)\
\
    # Parse into sections\
    sections = \{\}\
    current_section = None\
    for line in text.split("\\n"):\
        line = line.strip()\
        if not line:\
            continue\
\
        # Check for section headers (e.g., "EXPERIENCE", "SKILLS")\
        section_headers = ["EXPERIENCE", "SKILLS", "EDUCATION", "SUMMARY", "CERTIFICATIONS"]\
        if any(line.upper().startswith(header) for header in section_headers):\
            current_section = line.upper()\
            sections[current_section] = []\
        elif current_section:\
            sections[current_section].append(line)\
\
    # Extract name (first line, often bold/large)\
    name = extract_name(text)\
\
    # Extract contact info (email, phone)\
    contact = extract_contact(text)\
\
    return \{\
        "raw_text": text,\
        "sections": sections,\
        "name": name,\
        "contact": contact,\
    \}\
\
def extract_name(text: str) -> str:\
    """Extracts the name from the resume text (first line)."""\
    lines = text.split("\\n")\
    for line in lines:\
        line = line.strip()\
        if line and not any(c.isdigit() for c in line) and len(line.split()) <= 3:\
            return line\
    return ""\
\
def extract_contact(text: str) -> dict:\
    """Extracts email and phone from the resume text."""\
    # Extract email\
    email_match = re.search(r"\\b[\\w\\.-]+@[\\w\\.-]+\\.\\w+\\b", text)\
    email = email_match.group(0) if email_match else None\
\
    # Extract phone\
    phone_match = re.search(r"\\b(\\+?\\d\{1,3\}[-.\\s]?)?\\(?\\d\{3\}\\)?[-.\\s]?\\d\{3\}[-.\\s]?\\d\{4\}\\b", text)\
    phone = phone_match.group(0) if phone_match else None\
\
    return \{"email": email, "phone": phone\}\
