# In critique_resume() in orchestrator.py\
def critique_resume(resume_json_path: str, jd_path: str, profile_name: str) -> dict:\
    # ... existing code ...\
\
    # Add cultural fit scoring\
    jd_text = open(jd_path).read()\
    resume_text = json.dumps(resume_json)  # Simplified; could extract text from HTML\
\
    # Load cultural fit rules\
    cultural_fit_rules = load_yaml(os.path.join(SCORING_DIR, "cultural_fit.yaml"))\
\
    # Detect JD tone\
    jd_tone = detect_tone(jd_text, cultural_fit_rules["tone_keywords"])\
\
    # Detect resume tone\
    resume_tone = detect_tone(resume_text, cultural_fit_rules["tone_keywords"])\
\
    # Score tone match\
    tone_match_score = score_tone_match(jd_tone, resume_tone, cultural_fit_rules["scoring"]["tone_match"])\
\
    # Add to critique output\
    critique_output["CULTURAL_FIT"] = \{\
        "jd_tone": jd_tone,\
        "resume_tone": resume_tone,\
        "tone_match_score": tone_match_score,\
        "suggestions": generate_tone_suggestions(jd_tone, resume_tone),\
    \}\
\
    return critique_output\
\
def detect_tone(text: str, tone_keywords: dict) -> dict:\
    """Detects the dominant tone from text."""\
    text_lower = text.lower()\
    tone_scores = \{\}\
    for tone, keywords in tone_keywords.items():\
        count = sum(text_lower.count(kw) for kw in keywords)\
        tone_scores[tone] = count\
    # Return tone with highest score\
    dominant_tone = max(tone_scores.items(), key=lambda x: x[1])[0]\
    return \{tone: score for tone, score in tone_scores.items()\}\
\
def score_tone_match(jd_tone: dict, resume_tone: dict, weight: float) -> float:\
    """Scores how well the resume tone matches the JD tone."""\
    # Simple: score = overlap between dominant tones\
    jd_dominant = max(jd_tone.items(), key=lambda x: x[1])[0]\
    resume_dominant = max(resume_tone.items(), key=lambda x: x[1])[0]\
    return 100 * weight if jd_dominant == resume_dominant else 50 * weight\
