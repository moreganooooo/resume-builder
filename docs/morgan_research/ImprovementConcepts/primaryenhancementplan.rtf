# In validate_resume.py\
def validate_ats_parsing(pdf_path: str, resume_json: dict) -> dict:\
    """\
    Simulates how an ATS would parse the resume.\
    Returns:\
        - Parsed data (what the ATS extracted).\
        - Match score (how well it matches the original resume).\
        - Warnings (e.g., "Your 'Salesforce' claim was not extracted").\
    """\
    # Option 1: Use resumeparsing.com API (free tier available)\
    try:\
        import requests\
        API_KEY = os.environ.get("RESUMEPARSING_API_KEY")\
        if not API_KEY:\
            return \{"valid": True, "warnings": ["RESUMEPARSING_API_KEY not set; skipping ATS simulation"]\}\
\
        with open(pdf_path, "rb") as f:\
            files = \{"resume": f\}\
        response = requests.post(\
            "https://api.resumeparsing.com/v1/parse",\
            files=files,\
            headers=\{"Authorization": f"Bearer \{API_KEY\}"\},\
        )\
        parsed_data = response.json()\
\
        # Compare parsed data to original resume\
        atsmatch_score = compare_parsed_to_original(parsed_data, resume_json)\
\
        return \{\
            "valid": True,\
            "ats_parsing_match_score": atsmatch_score,\
            "parsed_data": parsed_data,\
            "warnings": generate_ats_warnings(parsed_data, resume_json),\
        \}\
    except Exception as e:\
        return \{"valid": True, "warnings": [f"ATS simulation failed: \{e\}"]\}\
\
def compare_parsed_to_original(parsed_data: dict, resume_json: dict) -> float:\
    """Compares parsed ATS data to original resume JSON."""\
    score = 0.0\
    total_checks = 0\
\
    # Check skills\
    parsed_skills = set(skill.lower() for skill in parsed_data.get("skills", []))\
    original_skills = set()\
    for category in resume_json.get("SKILLS", []):\
        original_skills.update(skill.lower() for skill in category.get("items", []))\
    skill_match = len(parsed_skills & original_skills) / len(original_skills) if original_skills else 1.0\
    score += skill_match * 0.3  # 30% weight\
    total_checks += 1\
\
    # Check experience\
    parsed_experience = parsed_data.get("experience", [])\
    original_experience = resume_json.get("EXPERIENCE", [])\
    exp_match = len(parsed_experience) / len(original_experience) if original_experience else 1.0\
    score += exp_match * 0.4  # 40% weight\
    total_checks += 1\
\
    # Check education\
    parsed_education = parsed_data.get("education", [])\
    original_education = resume_json.get("EDUCATION", [])\
    edu_match = len(parsed_education) / len(original_education) if original_education else 1.0\
    score += edu_match * 0.3  # 30% weight\
    total_checks += 1\
\
    return (score / total_checks) * 100 if total_checks > 0 else 100\
\
def generate_ats_warnings(parsed_data: dict, resume_json: dict) -> list:\
    """Generates warnings for ATS parsing issues."""\
    warnings = []\
\
    # Check for missing skills\
    original_skills = set()\
    for category in resume_json.get("SKILLS", []):\
        original_skills.update(skill.lower() for skill in category.get("items", []))\
    parsed_skills = set(skill.lower() for skill in parsed_data.get("skills", []))\
    missing_skills = original_skills - parsed_skills\
    if missing_skills:\
        warnings.append(f"ATS missed skills: \{', '.join(missing_skills)\}")\
\
    # Check for missing experience\
    original_companies = \{role.get("company", "").lower() for role in resume_json.get("EXPERIENCE", [])\}\
    parsed_companies = \{exp.get("company", "").lower() for exp in parsed_data.get("experience", [])\}\
    missing_companies = original_companies - parsed_companies\
    if missing_companies:\
        warnings.append(f"ATS missed companies: \{', '.join(missing_companies)\}")\
\
    return warnings\
