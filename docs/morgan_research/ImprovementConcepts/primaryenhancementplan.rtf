def generate_resume_variants(profile_name: str = None):\
    """Generates a base resume for each archetype in base_resumes.yaml."""\
    profile = profile_name or profile_paths.active_profile()\
    kb_dir = profile_paths.kb_dir(profile)\
    base_resumes_path = os.path.join(kb_dir, "base_resumes.yaml")\
\
    if not os.path.exists(base_resumes_path):\
        raise FileNotFoundError(f"Base resumes config not found: \{base_resumes_path\}")\
\
    base_resumes_config = yaml.safe_load(open(base_resumes_path))\
    base_resumes = base_resumes_config.get("base_resumes", [])\
\
    variants = \{\}\
    for archetype in base_resumes:\
        # Step 1: Mine bullets for this archetype\
        refined_bullets = mine_bullet_bank_for_archetype(archetype, profile)\
\
        # Step 2: Audit bullets\
        audited_bullets = audit_bullets_for_archetype(refined_bullets, archetype, profile)\
\
        # Step 3: Build resume JSON\
        resume_json = build_resume_for_archetype(audited_bullets, archetype, profile)\
\
        # Step 4: Save variant\
        variants[archetype["name"]] = resume_json\
\
    # Save variants\
    output_dir = profile_paths.output_dir(profile)\
    os.makedirs(os.path.join(output_dir, "variants"), exist_ok=True)\
    for archetype_name, resume_json in variants.items():\
        variant_path = os.path.join(output_dir, "variants", f"\{archetype_name\}.json")\
        with open(variant_path, "w") as f:\
            json.dump(resume_json, f, indent=2)\
\
    print(f"
\f3 \uc0\u9989
\f9  Generated \{len(variants)\} resume variants
\f10 \uc0\u8594
\f9  \{output_dir\}/variants/")\
    return variants\
\
def mine_bullet_bank_for_archetype(archetype: dict, profile_name: str) -> pd.DataFrame:\
    """Mines bullets for a specific archetype (not a JD)."""\
    profile = profile_name or profile_paths.active_profile()\
    kb_dir = profile_paths.kb_dir(profile)\
    vectors_path = os.path.join(kb_dir, "bullet_vectors_ge2_d768.npy")\
    meta_path = os.path.join(kb_dir, "bullet_vectors_ge2_d768.meta")\
    bullet_bank = pd.read_csv(meta_path["csv"])\
\
    # Load vectors\
    vectors = np.load(vectors_path)\
\
    # Create a "fake JD" for the archetype\
    keywords = archetype.get("metadata", \{\}).get("keywords", [])\
    fake_jd = " ".join(keywords)  # Simple concatenation\
\
    # Embed the fake JD\
    jd_embedding = GeminiClient.embed(fake_jd)\
\
    # Compute similarities\
    vectors_norm = vectors / np.linalg.norm(vectors, axis=1, keepdims=True)\
    jd_norm = jd_embedding / np.linalg.norm(jd_embedding)\
    similarities = np.dot(vectors_norm, jd_norm)\
\
    # Select top 30 bullets\
    top_k_indices = np.argsort(similarities)[-30:]\
    refined_bullets = bullet_bank.iloc[top_k_indices].copy()\
    refined_bullets["similarity_score"] = similarities[top_k_indices]\
\
    return refined_bullets\
