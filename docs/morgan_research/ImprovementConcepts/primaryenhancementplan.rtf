def validate_ats_parse(pdf_path: str, resume_json: dict) -> list:\
    """Validates that the ATS can parse the resume correctly."""\
    parsed_data = parse_pdf(pdf_path)\
    errors = []\
\
    # Check for missing sections\
    required_sections = ["EXPERIENCE", "SKILLS"]\
    for section in required_sections:\
        if section not in parsed_data["sections"] or not parsed_data["sections"][section]:\
            errors.append(f"Missing section: \{section\}")\
\
    # Check for missing name\
    if not parsed_data["name"]:\
        errors.append("Missing name in parsed output")\
\
    # Check for missing contact\
    if not parsed_data["contact"].get("email"):\
        errors.append("Missing email in parsed output")\
    if not parsed_data["contact"].get("phone"):\
        errors.append("Missing phone in parsed output")\
\
    # Check for skill extraction\
    parsed_skills = set(skill.lower() for skill in parsed_data["sections"].get("SKILLS", []))\
    original_skills = set()\
    for category in resume_json.get("SKILLS", []):\
        original_skills.update(skill.lower() for skill in category.get("items", []))\
    missing_skills = original_skills - parsed_skills\
    if missing_skills:\
        errors.append(f"ATS missed skills: \{', '.join(missing_skills)\}")\
\
    # Check for experience extraction\
    parsed_companies = \{exp.split("|")[1].strip().lower() if "|" in exp else exp.lower()\
                          for exp in parsed_data["sections"].get("EXPERIENCE", [])\}\
    original_companies = \{role.get("company", "").lower() for role in resume_json.get("EXPERIENCE", [])\}\
    missing_companies = original_companies - parsed_companies\
    if missing_companies:\
        errors.append(f"ATS missed companies: \{', '.join(missing_companies)\}")\
\
    return errors\
