def extract_requirements(jd_data: dict) -> list:\
    """Extracts skills, experience, and other requirements from a JD."""\
    requirements = []\
\
    # Extract from must_have_skills\
    for skill in jd_data.get("must_have_skills", []):\
        requirements.append(skill)\
\
    # Extract from nice_to_have_skills\
    for skill in jd_data.get("nice_to_have_skills", []):\
        requirements.append(skill)\
\
    # Extract from description (using NLP or keyword extraction)\
    description = jd_data.get("description", "")\
    if description:\
        # Simple keyword extraction (could be enhanced with NLP)\
        keywords = extract_keywords(description)\
        requirements.extend(keywords)\
\
    # Deduplicate\
    requirements = list(set(requirements))\
    return requirements\
