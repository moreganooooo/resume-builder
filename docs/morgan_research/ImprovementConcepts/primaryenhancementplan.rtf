def validate_bullet_quality(bullet: str, style_rules: dict) -> list:\
    """Checks a bullet for semantic issues (beyond formatting)."""\
    issues = []\
\
    # Check for no metric\
    if not re.search(r"\\d+[\\.,]?\\d*", bullet):\
        issues.append(\{\
            "issue": "no_metric",\
            "message": "Consider adding a quantifiable result to show impact.",\
            "severity": "warning",\
        \})\
\
    # Check for passive voice\
    passive_voice_patterns = [\
        r"\\bam\\b|\\bare\\b|\\bis\\b|\\bwas\\b|\\bwere\\b|\\bbe\\b|\\bbeing\\b|\\bby\\b",\
        r"\\bpassive\\b|\\bhandled\\b|\\bmanaged\\b",  # Weak verbs\
    ]\
    for pattern in passive_voice_patterns:\
        if re.search(pattern, bullet, re.IGNORECASE):\
            issues.append(\{\
                "issue": "passive_voice",\
                "message": "Rewrite in active voice (e.g., 'Built X' instead of 'X was built').",\
                "severity": "warning",\
            \})\
            break\
\
    # Check for generic phrasing\
    generic_phrases = [\
        "responsible for",\
        "duties included",\
        "worked on",\
        "involved in",\
        "assisted with",\
    ]\
    for phrase in generic_phrases:\
        if phrase in bullet.lower():\
            issues.append(\{\
                "issue": "generic_phrasing",\
                "message": f"Replace '\{phrase\}' with a stronger, more specific verb.",\
                "severity": "error",\
            \})\
            break\
\
    # Check for too many actions (and)\
    if bullet.lower().count(" and ") > 1:\
        issues.append(\{\
            "issue": "too_many_actions",\
            "message": "Split this bullet into multiple bullets (one per action).",\
            "severity": "warning",\
        \})\
\
    return issues\
