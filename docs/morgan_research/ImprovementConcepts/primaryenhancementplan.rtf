\f1\fs22 \cf3 \cb4 \strokec3 Copy
\f9\fs26 \cf0 \cb1 \strokec2 \
def score_base_resume(base_resume: dict, jd_data: dict) -> float:\
    # 1. Skill Coverage Score (40%)\
    jd_keywords = extract_keywords(jd_data["description"])\
    base_keywords = extract_keywords(base_resume["summary"] + " " + " ".join(base_resume["skills"]))\
    skill_score = len(set(jd_keywords) & set(base_keywords)) / len(jd_keywords) if jd_keywords else 1.0\
\
    # 2. Title/Level Match (20%)\
    title_score = fuzzy_match(jd_data["title"], base_resume["target_title"])\
\
    # 3. Experience Relevance (20%)\
    exp_score = min(jd_data.get("years_required", 0) / max(base_resume["years_experience"], 1), 1.0)\
\
    # 4. Recency/Domain Fit (10%)\
    recency_score = domain_similarity(jd_data["industry"], base_resume["industry"])\
\
    # 5. Free-Text Similarity (10%)\
    jd_embedding = embed_text(jd_data["description"])\
    base_embedding = embed_text(base_resume["summary"] + " " + " ".join(base_resume["skills"]))\
    sim_score = cosine_similarity(jd_embedding, base_embedding)\
\
    return 0.4*skill_score + 0.2*title_score + 0.2*exp_score + 0.1*recency_score + 0.1*sim_score\
