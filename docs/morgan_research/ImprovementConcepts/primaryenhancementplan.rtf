def plan_resume(jd_data: dict, base_resume: dict, profile_data: dict) -> dict:\
    """Generates a structured plan for tailoring the resume."""\
    prompt = f"""---\
    You are a resume strategist. Your job is to analyze the job description and the base resume,\
    then create a plan for tailoring the resume to the JD.\
\
    ### Job Description:\
    \{json.dumps(jd_data, indent=2)\}\
\
    ### Base Resume:\
    \{json.dumps(base_resume, indent=2)\}\
\
    ### Profile Data:\
    \{json.dumps(profile_data, indent=2)\}\
\
    Output a JSON object with:\
    - missing_skills: list of skills from the JD that are missing from the base resume and profile.\
    - focus_sections: list of sections to emphasize (e.g., ["Experience", "Skills"]).\
    - drop_bullets: list of bullet IDs to remove (if they don\'92t match the JD).\
    - add_bullets: list of bullet IDs to add (from the profile\'92s bullet bank).\
    - section_order: list of sections in the desired order.\
    """\
\
    text, _ = GeminiClient.generate(\
        model="gemini-3.1-flash-lite",\
        system_instruction="You are a precise resume strategist. Follow all rules strictly.",\
        contents=prompt,\
        temperature=0.0,\
    )\
\
    try:\
        return GeminiClient.parse_json(text)\
    except Exception:\
        return \{\
            "missing_skills": [],\
            "focus_sections": [],\
            "drop_bullets": [],\
            "add_bullets": [],\
            "section_order": [],\
        \}\
