{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/data/**",
              "components/print/**",
              "components/terminal/**",
              "ui_kits/cli/**",
              "ui_kits/dashboard/**",
              "ui_kits/resume/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:DM Serif Display|DM Sans|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: DM Serif Display, DM Sans, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='CliBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|tagline|lines|key|ref|className|style|children)$/]",
        "message": "<CliBanner> doesn't accept that prop. Declared props: title, tagline, lines."
      },
      {
        "selector": "JSXOpeningElement[name.name='CliFooterBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|key|ref|className|style|children)$/]",
        "message": "<CliFooterBar> doesn't accept that prop. Declared props: variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='CliFooterBar'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:nav|execution)$/]",
        "message": "<CliFooterBar> variant must be one of 'nav' | 'execution'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CliMenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|hint|hook|key|ref|className|style|children)$/]",
        "message": "<CliMenuItem> doesn't accept that prop. Declared props: label, icon, hint, hook."
      },
      {
        "selector": "JSXOpeningElement[name.name='CliModeBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:product|screen|mode|key|ref|className|style|children)$/]",
        "message": "<CliModeBar> doesn't accept that prop. Declared props: product, screen, mode."
